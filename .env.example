# ── Google Gemini LLM Provider ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Alternative: OpenAI-compatible Endpoint ───────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev): sqlite+aiosqlite:///./autoanalyst.db
# PostgreSQL (prod): postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./autoanalyst.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Cache ─────────────────────────────────────────────────────────────────────
# TTL in seconds for cached successful query results.
# NOTE: TTL limits cache age only; it does NOT guarantee the underlying data
# has not changed. Use CACHE_MAX_SIZE to limit memory usage.
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=512

# ── Orchestration ─────────────────────────────────────────────────────────────
MAX_RETRIES=3
# Max rows returned per query (safety limit)
QUERY_ROW_LIMIT=1000
# Query execution timeout in seconds
QUERY_TIMEOUT_SECONDS=30
